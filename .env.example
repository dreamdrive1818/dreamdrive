PORT=5000
RUN_MODE=monolith

# Firebase Admin — paste full service-account JSON as one line (Railway variable)
# FIREBASE_CONFIG={"type":"service_account","project_id":"dreamdrive-307ed",...}

# Optional Redis (OTP). Set USE_REDIS=false to skip.
USE_REDIS=false
# REDIS_URI=redis://default:PASSWORD@host:port

# Gmail OAuth (OTP + booking confirmation mail)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=dreamdrive1818@gmail.com
REDIRECT_URI=https://developers.google.com/oauthplayground

# Cloudinary (webhook image uploads)
REACT_APP_CLOUDINARY_CLOUD_NAME=
REACT_APP_CLOUDINARY_PRESET=

# Zoho (only if using Zoho flows)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
ZOHO_USERNAME=
ZOHO_PASSWORD=

# Split mode only (ignore for Railway monolith)
IDENTITY_URL=http://127.0.0.1:5001
NOTIFY_URL=http://127.0.0.1:5002
CRM_URL=http://127.0.0.1:5003
BOOKING_URL=http://127.0.0.1:5004
CATALOG_URL=http://127.0.0.1:5005
